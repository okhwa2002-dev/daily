# API
PORT=3001
NODE_ENV=development

# 로컬 개발용 PostgreSQL 컨테이너 (docker-compose.yml)
POSTGRES_USER=daily
POSTGRES_PASSWORD=
POSTGRES_PORT=5438
POSTGRES_DB=daily

# PostgreSQL — 위 컨테이너 기준. POSTGRES_PORT를 바꾸면 아래 포트도 함께 바꾼다.
DATABASE_URL=postgres://daily:PASSWORD@localhost:5438/daily
DATABASE_URL_TEST=postgres://daily:PASSWORD@localhost:5438/daily_test

# 인증
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# 환경변수 — 실제 값은 절대 커밋하지 않는다
.env
.env.*
!.env.example

# 의존성
node_modules/
.pnpm-store/

# 빌드 산출물
dist/
build/
*.tsbuildinfo

# 테스트
coverage/
playwright-report/
test-results/

# 로그
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# 에디터 / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Claude Code — 규칙 문서(.claude/roles/)는 커밋 대상이다.
# 로컬 개인 설정만 제외한다.
.claude/settings.local.json

# OMC 로컬 산출물 — 전부 공유 대상이 아니다.
# project-memory.json은 절대 경로와 파일 접근 타임스탬프를 담은 캐시라
# 기기마다 다르고 파일을 열 때마다 바뀐다. 공유할 프로젝트 지식은
# CLAUDE.md와 .claude/roles/에 사람이 읽을 수 있는 형태로 적는다.
.omc/

# 에이전트 작업 스크래치 (브리프·보고서·리뷰·diff)
.superpowers/

# Git worktrees created for isolated feature implementation
.worktrees/
